# Solo necesarias para el primer login (python -m app.login).
GB_GARMIN_EMAIL=tu@email.com
GB_GARMIN_PASSWORD=tu_password

# Token para proteger la API y el endpoint MCP. Genera uno largo:
#   openssl rand -hex 32
GB_API_TOKEN=pon_aqui_un_token_largo

GB_TIMEZONE=Europe/Madrid
GB_SYNC_ENABLED=true
GB_SYNC_INTERVAL_MINUTES=60
GB_SYNC_BACKFILL_DAYS=7
