# Solo necesarias para el primer login (python -m app.login).
GB_GARMIN_EMAIL=tu@email.com
GB_GARMIN_PASSWORD=tu_password

# Token para proteger la API y el endpoint MCP. Genera uno largo:
#   openssl rand -hex 32
GB_API_TOKEN=pon_aqui_un_token_largo

# Cifra los tokens de Garmin en la base de datos. OBLIGATORIA: sin ella no se
# puede leer ni escribir ninguna sesion. Generala con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si la pierdes, cada usuario tendra que volver a vincular su cuenta de Garmin.
GB_ENCRYPTION_KEY=

# Identificador del dueño. Los datos anteriores al multiusuario se le atribuyen
# a el en la migracion, asi que no lo cambies despues de arrancar.
GB_OWNER_USER_ID=owner

# Dominios publicos por los que se sirve el MCP, separados por comas. Sin esto,
# detras de un proxy el SDK responde 421 a todo (proteccion anti DNS rebinding).
GB_ALLOWED_HOSTS=

GB_TIMEZONE=Europe/Madrid
GB_SYNC_ENABLED=true
GB_SYNC_INTERVAL_MINUTES=60
GB_SYNC_BACKFILL_DAYS=7

# Opcionales: solo hacen falta para poder vincular Strava desde el panel.
# Se crean en https://www.strava.com/settings/api. El "Authorization Callback
# Domain" que pide el formulario es el host de GB_PUBLIC_URL, sin esquema ni
# ruta (p.ej. garmin.tudominio.com, no https://garmin.tudominio.com/mcp).
# Sin rellenar, el boton de Strava no aparece en el panel.
GB_STRAVA_CLIENT_ID=
GB_STRAVA_CLIENT_SECRET=
